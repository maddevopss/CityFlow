generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Municipality {
  id                         Int                         @id @default(autoincrement())
  name                       String                      @unique
  code                       String?                     @unique
  population                 Int?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  users                      User[]
  events                     RoadEvent[]
  inspections                Inspection[]
  inspectionEvidence         InspectionEvidence[]
  citizenRequests            CitizenRequest[]
  citizenEvents              CitizenRequestEvent[]
  citizenMessages            CitizenMessage[]
  notifications              Notification[]
  permitDocumentRequirements PermitDocumentRequirement[]
}

model PermitDocumentRequirement {
  id                    String       @id @default(uuid()) @db.Uuid
  municipalityId        Int
  permitSubtype         String
  requiredDocumentTypes Json         @default("[]") @db.JsonB
  updatedBy             String?      @db.Uuid
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  municipality          Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@unique([municipalityId, permitSubtype])
  @@index([municipalityId, updatedAt])
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique
  password            String
  fullName            String?
  role                String       @default("VIEWER")
  municipalityId      Int?
  isActive             Boolean      @default(true)
  lastLogin            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  municipality        Municipality? @relation(fields: [municipalityId], references: [id])
  assignedInspections Inspection[]  @relation("AssignedInspector")
  citizenRequests     CitizenRequest[] @relation("CitizenRequests")
  assignedRequests    CitizenRequest[] @relation("AssignedCitizenRequests")
  citizenEvents       CitizenRequestEvent[]
  citizenMessages     CitizenMessage[]
  notifications       Notification[]
}

model RoadEvent {
  id              String     @id @default(uuid()) @db.Uuid
  municipalityId  Int
  eventType       String
  subtype         String
  geometry        Json       @db.JsonB
  startTime       DateTime
  endTime         DateTime?
  impacts         Json       @default("[]") @db.JsonB
  details         Json       @default("{}") @db.JsonB
  sourceType      String     @default("PERMIT")
  sourceRef       String?
  status          String     @default("DRAFT")
  statusReason    String?
  recurrenceRule  String?
  contractorEmail String?
  contractorToken String?    @unique
  autoGenerated   Boolean    @default(false)
  confidence      Float?
  createdBy       String?    @db.Uuid
  submittedBy     String?    @db.Uuid
  approvedBy      String?    @db.Uuid
  publishedBy     String?    @db.Uuid
  closedBy        String?    @db.Uuid
  submittedAt     DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  municipality    Municipality @relation(fields: [municipalityId], references: [id])

  @@index([municipalityId, status])
  @@index([startTime, endTime])
}

model Inspection {
  id               String       @id @default(uuid()) @db.Uuid
  municipalityId   Int
  permitId          String?      @db.Uuid
  assignedTo        String?      @db.Uuid
  assignedAt        DateTime?
  assignedBy        String?      @db.Uuid
  scheduledAt       DateTime
  completedAt       DateTime?
  address           String
  inspectionType    String
  status            String       @default("SCHEDULED")
  outcome           String?
  notes             String?
  findings          String?
  createdBy         String       @db.Uuid
  completedBy       String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  municipality      Municipality @relation(fields: [municipalityId], references: [id])
  inspector         User?        @relation("AssignedInspector", fields: [assignedTo], references: [id])
  evidence          InspectionEvidence[]
  reminders         InspectionReminder[]

  @@index([municipalityId, status])
  @@index([municipalityId, scheduledAt])
  @@index([municipalityId, assignedTo])
  @@index([permitId])
}

model InspectionEvidence {
  id             String       @id @default(uuid()) @db.Uuid
  municipalityId Int
  inspectionId   String       @db.Uuid
  evidenceType   String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  sha256         String
  description    String?
  capturedAt     DateTime
  uploadedBy     String       @db.Uuid
  createdAt      DateTime     @default(now())

  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  inspection     Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([municipalityId, storageKey])
  @@index([municipalityId, inspectionId])
  @@index([inspectionId, capturedAt])
  @@index([sha256])
}

model InspectionReminder {
  id             String     @id @default(uuid()) @db.Uuid
  municipalityId Int
  inspectionId   String     @db.Uuid
  recipientId    String     @db.Uuid
  reminderType   String
  scheduledFor   DateTime
  status         String     @default("PENDING")
  acknowledgedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  inspection     Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, recipientId, reminderType, scheduledFor])
  @@index([municipalityId, recipientId, status])
  @@index([scheduledFor, status])
}

model CitizenRequest {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId Int
  citizenId      String   @db.Uuid
  assignedTo     String?  @db.Uuid
  assignedTeam   String?
  title          String
  description    String
  category       String   @default("OTHER")
  status         String   @default("SUBMITTED")
  location       Json?    @db.JsonB
  attachments    Json     @default("[]") @db.JsonB
  resolution     String?
  assignedAt     DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  citizen        User         @relation("CitizenRequests", fields: [citizenId], references: [id])
  assignee       User?        @relation("AssignedCitizenRequests", fields: [assignedTo], references: [id])
  events         CitizenRequestEvent[]
  messages       CitizenMessage[]
  notifications  Notification[]

  @@index([municipalityId, status, updatedAt])
  @@index([municipalityId, citizenId, updatedAt])
  @@index([municipalityId, assignedTo, status])
  @@index([category, status])
}

model CitizenRequestEvent {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId Int
  requestId      String   @db.Uuid
  actorId        String?  @db.Uuid
  eventType      String
  fromStatus     String?
  toStatus       String?
  metadata       Json     @default("{}") @db.JsonB
  createdAt      DateTime @default(now())

  municipality   Municipality   @relation(fields: [municipalityId], references: [id])
  request        CitizenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor          User?          @relation(fields: [actorId], references: [id])

  @@index([municipalityId, requestId, createdAt])
  @@index([actorId, createdAt])
}

model CitizenMessage {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId Int
  requestId      String   @db.Uuid
  authorId       String   @db.Uuid
  body           String
  visibility     String   @default("CITIZEN")
  createdAt      DateTime @default(now())

  municipality   Municipality   @relation(fields: [municipalityId], references: [id])
  request        CitizenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id])

  @@index([municipalityId, requestId, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id             String   @id @default(uuid()) @db.Uuid
  municipalityId Int
  recipientId    String   @db.Uuid
  requestId      String?  @db.Uuid
  eventType      String
  channel        String   @default("IN_APP")
  subject        String?
  body           String
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipality   Municipality    @relation(fields: [municipalityId], references: [id])
  recipient      User            @relation(fields: [recipientId], references: [id])
  request        CitizenRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([municipalityId, recipientId, status, createdAt])
  @@index([municipalityId, eventType, createdAt])
  @@index([nextAttemptAt, status])
}
