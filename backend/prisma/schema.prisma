generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Municipality {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String?      @unique
  population  Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  events      RoadEvent[]
  inspections Inspection[]
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  password       String
  fullName       String?
  role           String    @default("VIEWER")
  municipalityId Int?
  isActive       Boolean   @default(true)
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
}

model RoadEvent {
  id              String     @id @default(uuid()) @db.Uuid
  municipalityId  Int
  eventType       String
  subtype         String
  geometry        Json       @db.JsonB
  startTime       DateTime
  endTime         DateTime?
  impacts         Json       @default("[]") @db.JsonB
  details         Json       @default("{}") @db.JsonB
  sourceType      String     @default("PERMIT")
  sourceRef       String?
  status          String     @default("DRAFT")
  statusReason    String?
  recurrenceRule  String?
  contractorEmail String?
  contractorToken String?    @unique
  autoGenerated   Boolean    @default(false)
  confidence      Float?
  createdBy       String?    @db.Uuid
  submittedBy     String?    @db.Uuid
  approvedBy      String?    @db.Uuid
  publishedBy     String?    @db.Uuid
  closedBy        String?    @db.Uuid
  submittedAt     DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  municipality    Municipality @relation(fields: [municipalityId], references: [id])

  @@index([municipalityId, status])
  @@index([startTime, endTime])
}

model Inspection {
  id               String       @id @default(uuid()) @db.Uuid
  municipalityId   Int
  permitId          String?      @db.Uuid
  scheduledAt       DateTime
  completedAt       DateTime?
  address           String
  inspectionType    String
  status            String       @default("SCHEDULED")
  outcome           String?
  notes             String?
  findings          String?
  createdBy         String       @db.Uuid
  completedBy       String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  municipality     Municipality @relation(fields: [municipalityId], references: [id])

  @@index([municipalityId, status])
  @@index([municipalityId, scheduledAt])
  @@index([permitId])
}
