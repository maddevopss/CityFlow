generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Municipality {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  code               String?              @unique
  population         Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  users              User[]
  events             RoadEvent[]
  inspections        Inspection[]
  inspectionEvidence InspectionEvidence[]
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique
  password            String
  fullName            String?
  role                String       @default("VIEWER")
  municipalityId      Int?
  isActive             Boolean      @default(true)
  lastLogin            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  municipality        Municipality? @relation(fields: [municipalityId], references: [id])
  assignedInspections Inspection[]  @relation("AssignedInspector")
}

model RoadEvent {
  id String @id @default(uuid()) @db.Uuid
  municipalityId Int
  eventType String
  subtype String
  geometry Json @db.JsonB
  startTime DateTime
  endTime DateTime?
  impacts Json @default("[]") @db.JsonB
  details Json @default("{}") @db.JsonB
  sourceType String @default("PERMIT")
  sourceRef String?
  status String @default("DRAFT")
  statusReason String?
  recurrenceRule String?
  contractorEmail String?
  contractorToken String? @unique
  autoGenerated Boolean @default(false)
  confidence Float?
  createdBy String? @db.Uuid
  submittedBy String? @db.Uuid
  approvedBy String? @db.Uuid
  publishedBy String? @db.Uuid
  closedBy String? @db.Uuid
  submittedAt DateTime?
  approvedAt DateTime?
  publishedAt DateTime?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  municipality Municipality @relation(fields: [municipalityId], references: [id])
  @@index([municipalityId, status])
  @@index([startTime, endTime])
}

model Inspection {
  id String @id @default(uuid()) @db.Uuid
  municipalityId Int
  permitId String? @db.Uuid
  assignedTo String? @db.Uuid
  assignedAt DateTime?
  assignedBy String? @db.Uuid
  scheduledAt DateTime
  completedAt DateTime?
  address String
  inspectionType String
  status String @default("SCHEDULED")
  outcome String?
  notes String?
  findings String?
  createdBy String @db.Uuid
  completedBy String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  municipality Municipality @relation(fields: [municipalityId], references: [id])
  inspector User? @relation("AssignedInspector", fields: [assignedTo], references: [id])
  evidence InspectionEvidence[]
  reminders InspectionReminder[]
  @@index([municipalityId, status])
  @@index([municipalityId, scheduledAt])
  @@index([municipalityId, assignedTo])
  @@index([permitId])
}

model InspectionEvidence {
  id String @id @default(uuid()) @db.Uuid
  municipalityId Int
  inspectionId String @db.Uuid
  evidenceType String
  fileName String
  mimeType String
  sizeBytes Int
  storageKey String
  sha256 String
  description String?
  capturedAt DateTime
  uploadedBy String @db.Uuid
  createdAt DateTime @default(now())
  municipality Municipality @relation(fields: [municipalityId], references: [id])
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  @@unique([municipalityId, storageKey])
  @@index([municipalityId, inspectionId])
  @@index([inspectionId, capturedAt])
  @@index([sha256])
}

model InspectionReminder {
  id String @id @default(uuid()) @db.Uuid
  municipalityId Int
  inspectionId String @db.Uuid
  recipientId String @db.Uuid
  reminderType String
  scheduledFor DateTime
  status String @default("PENDING")
  acknowledgedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  @@unique([inspectionId, recipientId, reminderType, scheduledFor])
  @@index([municipalityId, recipientId, status])
  @@index([scheduledFor, status])
}

model WorkOrder {
  id String @id @default(uuid()) @db.Uuid
  municipalityId Int
  publicNumber String
  title String
  description String
  workType String
  priority String @default("NORMAL")
  status String @default("DRAFT")
  assetId String? @db.Uuid
  citizenReportId String? @db.Uuid
  assignedTeamId String? @db.Uuid
  scheduledStart DateTime?
  scheduledEnd DateTime?
  startedAt DateTime?
  completedAt DateTime?
  verifiedAt DateTime?
  estimatedCost Decimal? @db.Decimal(14,2)
  actualCost Decimal? @db.Decimal(14,2)
  createdBy String @db.Uuid
  updatedBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs WorkLog[]
  @@unique([municipalityId, publicNumber])
  @@index([municipalityId, status, priority])
  @@index([municipalityId, assignedTeamId, status])
  @@index([assetId])
  @@index([citizenReportId])
}

model WorkLog {
  id String @id @default(uuid()) @db.Uuid
  municipalityId Int
  workOrderId String @db.Uuid
  logType String
  description String
  hours Decimal? @db.Decimal(8,2)
  materialCost Decimal? @db.Decimal(14,2)
  equipmentCost Decimal? @db.Decimal(14,2)
  performedAt DateTime
  performedBy String @db.Uuid
  createdAt DateTime @default(now())
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  @@index([municipalityId, workOrderId, performedAt])
}
