DATABASE_URL="postgresql://cityflow:change_me@localhost:5432/cityflow"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRATION="1h"
PERMIT_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
PERMIT_WEBHOOK_TOLERANCE_SECONDS=300
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000/api/v1"
LOG_LEVEL="debug"

# Récupération du mot de passe — exemple SMTP2GO
SMTP_HOST="mail.smtp2go.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="replace-with-smtp2go-username"
SMTP_PASSWORD="replace-with-smtp2go-password"
MAIL_FROM="CityFlow <no-reply@example.invalid>"
PUBLIC_APP_URL="http://localhost:5173"

# Requis uniquement pour la diffusion Waze CCP (services/diffusionService.js)
WAZE_CCP_URL="https://example-waze-ccp.invalid/partner-feed"
