# ========== DATABASE ==========
DATABASE_URL="postgresql://cityflow:change_me_securely@localhost:5432/cityflow"
DB_USER="cityflow"
DB_PASSWORD="change_me_securely"
DB_NAME="cityflow"

# ========== REDIS ==========
REDIS_URL="redis://localhost:6379"
REDIS_RATE_LIMIT_ENABLED=false

# ========== JWT & AUTHENTICATION ==========
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-at-least-32-random-characters-min-32-bytes"
JWT_EXPIRATION="1h"
JWT_ISSUER="cityflow"
JWT_AUDIENCE="cityflow-api"
REFRESH_TOKEN_TTL_DAYS=30

# ========== PERMIT WEBHOOK ==========
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PERMIT_WEBHOOK_SECRET="replace-with-at-least-32-random-characters-min-32-bytes"
PERMIT_WEBHOOK_TOLERANCE_SECONDS=300

# ========== SERVER CONFIGURATION ==========
PORT=3000
NODE_ENV="development"
LOG_LEVEL="debug"

# ========== FRONTEND & CORS ==========
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
API_URL="http://localhost:3000/api/v1"

# ========== EXTERNAL SERVICES ==========
# Required only for Waze CCP diffusion (services/diffusionService.js)
WAZE_CCP_URL="https://example-waze-ccp.invalid/partner-feed"
